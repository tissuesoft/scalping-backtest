# Binance USD-M Futures DEMO orders (https://demo.binance.com)
# Copy to .env and fill keys. Never commit .env.

BINANCE_DEMO_API_KEY=
BINANCE_DEMO_API_SECRET=

# Demo REST (orders / balance only)
BINANCE_DEMO_BASE_URL=https://demo-fapi.binance.com

# Real Futures market data (charts / 1m klines / price) — NOT demo
BINANCE_MARKET_BASE_URL=https://fapi.binance.com

# 1 = dry-run (signals + sizing logs, no orders). Use --live CLI to override.
BINANCE_DEMO_DRY_RUN=1

# Match backtest leverage (start lower if you want, e.g. 10)
BINANCE_DEMO_LEVERAGE=100

# Poll interval seconds
BINANCE_DEMO_POLL_SEC=15

# Paper equity used only in dry-run sizing
BINANCE_DEMO_PAPER_EQUITY=100

# Supabase — PORT5 dedicated project (not autotrade)
# Tables: trade_events, market_snapshots, ohlcv_bars, runner_heartbeats
SUPABASE_URL=
SUPABASE_ANON_KEY=
